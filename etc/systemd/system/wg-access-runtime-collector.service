[Unit]
Description=WG Access read-only runtime telemetry collector
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/wg-access/agent
Environment=WG_ACCESS_AGENT_ENV=/opt/wg-access/agent/agent.env
ExecStart=/opt/wg-access/agent/wg_runtime_collector.py
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
